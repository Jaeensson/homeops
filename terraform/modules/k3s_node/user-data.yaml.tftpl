#cloud-config
timezone: Europe/Stockholm
hostname: ${node_name}
disable_root: False
ssh_deletekeys: False
ssh_pwauth: False
ssh_authorized_keys:
  - ${ssh_keys}
disk_setup:
  /dev/sdb:
    table_type: gpt
    layout: true
    overwrite: false
fs_setup:
  - device: /dev/sdb1
    filesystem: ext4
mounts:
  - [/dev/sdb1, /var/lib/rancher/k3s/storage, ext4, defaults,noatime, "0", "0"]
package_reboot_if_required: true
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - curl
  - nfs-common
  - open-iscsi
runcmd:
  - systemctl enable --now qemu-guest-agent
  - curl -sfL https://get.k3s.io | sh -
power_state:
  delay: "now"
  mode: reboot
  message: "Cloud-init complete, rebooting"
  timeout: 30
