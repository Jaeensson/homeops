# Create bootstrap secrets from environment variables
bootstrap-secrets:
    kubectl create namespace external-secrets --dry-run=client -o yaml | kubectl apply -f -
    envsubst < {{source_directory()}}/bootstrap/infisical-secret.yaml.tpl | kubectl apply -f -

# Bootstrap Flux onto the cluster
bootstrap: bootstrap-secrets
    kubectl apply -f {{source_directory()}}/flux-system/gotk-components.yaml
    kubectl create secret generic flux-system \
        -n flux-system \
        --from-literal=username=git \
        --from-literal=password="$GITHUB_TOKEN" \
        --dry-run=client -o yaml | kubectl apply -f -
    kubectl apply -f {{source_directory()}}/flux-system/gotk-sync.yaml

# Show cluster and Flux sync status
status:
    kubectl get nodes
    kubectl get kustomizations -A
    kubectl get gitrepositories -A
