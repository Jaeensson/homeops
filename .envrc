export KUBECONFIG=$PWD/kubeconfig.yaml

# Local overrides (gitignored) - use for sensitive or personal env vars
[[ -f .envrc.local ]] && source .envrc.local
use flake

if [[ -n "${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID:-}" && -n "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET:-}" && -n "${INFISICAL_API_URL:-}" && -n "${INFISICAL_PROJECT_ID:-}" ]]; then
  echo "Fetching project secrets from Infisical..."
  export INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_UNIVERSAL_AUTH_CLIENT_ID --client-secret=$INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET --domain $INFISICAL_API_URL --plain --silent)
  eval "$(infisical export --projectId $INFISICAL_PROJECT_ID --env prod --format=dotenv-export --path /_project --silent)"
fi