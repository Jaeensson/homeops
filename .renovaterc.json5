{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>home-operations/renovate-presets#1.3.0",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeDigest",
    ":timezone(Europe/Stockholm)"
  ],
  "packageRules": [
    {
      "description": "Flux Operator Group",
      "groupName": "flux-operator",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/"
      ],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    }
  ]
}