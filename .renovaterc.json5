{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#5.0.0",
    ":timezone(Europe/Stockholm)"
  ],
  rebaseWhen: "conflicted",
  helmfile: {
    managerFilePatterns: [
      "/helmfile\\.(?:apps|crds)\\.yaml$/"
    ],
  },
  packageRules: [
    {
      description: "Linuxserver image versioning fix",
      matchDatasources: ["docker"],
      matchPackagePrefixes: ["ghcr.io/linuxserver/"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    // Auto-merge rules
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: [
        "docker"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      matchPackageNames: [
        "/kube-prometheus-stack/"
      ],
      automerge: true,
      automergeType: "pr",
      prCreation: "status-success",
      ignoreTests: false,
      schedule: [
        "before 6am on Monday"
      ],
    },
    {
      description: "Auto-merge Helm & container patch+minor updates",
      matchDatasources: [
        "docker",
        "helm"
      ],
      matchUpdateTypes: [
        "minor",
        "patch"
      ],
      automerge: true,
      automergeType: "pr",
      prCreation: "status-success",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "/flux-operator/",
        "/flux-instance/"
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Labeling rules
    {
      matchUpdateTypes: [
        "major"
      ],
      addLabels: [
        "type/major"
      ],
    },
    {
      matchUpdateTypes: [
        "minor"
      ],
      addLabels: [
        "type/minor"
      ],
    },
    {
      matchUpdateTypes: [
        "patch"
      ],
      addLabels: [
        "type/patch"
      ],
    },
    {
      matchUpdateTypes: [
        "digest"
      ],
      addLabels: [
        "type/digest"
      ],
    },
    {
      matchDatasources: [
        "docker"
      ],
      addLabels: [
        "renovate/container"
      ],
    },
    {
      matchDatasources: [
        "helm"
      ],
      addLabels: [
        "renovate/helm"
      ],
    },
    {
      matchDatasources: [
        "github-releases"
      ],
      addLabels: [
        "renovate/github-release"
      ],
    },
  ]
}
